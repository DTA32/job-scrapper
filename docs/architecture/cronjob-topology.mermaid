flowchart TB
    subgraph k8s["Kubernetes objects"]
        direction TB
        CJ["CronJob job-scraper-bot<br/>schedule 0 20 * * *<br/>timeZone Asia/Jakarta<br/>concurrencyPolicy Forbid"]
        JOB["Job - one per tick<br/>restartPolicy OnFailure"]
        POD["Pod job-scraper-bot<br/>image dta32/job-scrapper-orangemangodimz-bot<br/>nodeAffinity preferred vps-01eb7b22<br/>command /bin/sh cron/run-scraper.sh"]
        CJ -->|"fires, skipped if the last one still runs"| JOB --> POD
    end

    CM[("ConfigMap job-scraper-config<br/>BOT_MODEL, MONGO_DB_NAME, MONGO_COLLECTION_NAME,<br/>TZ, MAX_CHARS,<br/>CLAUDE_CONFIG_DIR, CLAUDE_CONFIG_FILE")]
    SEC[("Secret job-scraper-secret<br/>MONGO_URI<br/>DISCORD_WEBHOOK_URL")]
    PVC[("PVC job-scraper-claude-pvc<br/>mounted at /claude-config<br/>the ONLY source of claude auth -<br/>seeded by a claude login elsewhere")]

    CM -->|"envFrom"| POD
    SEC -->|"envFrom"| POD
    PVC -->|"volumeMount"| POD

    subgraph container["inside the pod"]
        direction TB
        SH["cron/run-scraper.sh<br/>POSIX sh, tees everything to cron/scraper.log"]
        CLAUDE["claude --model $BOT_MODEL<br/>--mcp-config .mcp.json --strict-mcp-config<br/>--dangerously-skip-permissions<br/>--verbose --output-format stream-json<br/>-p prompts/scrape-and-post.md"]
        RC{"exit code == 0?"}
        OKLOG["log 'run complete'"]
        ERRLOG["log ERROR to stderr<br/>Job restarts per restartPolicy OnFailure"]
        SH --> CLAUDE --> RC
        RC -->|"yes"| OKLOG
        RC -->|"no"| ERRLOG
    end

    POD --> SH

    MCP["Service job-scraper-mcp-service<br/>tools scrape_jobs + update_scrape_run<br/>see mcp-topology.mermaid"]
    DISCORD(["Discord webhook<br/>DISCORD_WEBHOOK_URL"])

    CLAUDE -->|"MCP over HTTP"| MCP
    CLAUDE -->|"node cron/send-digest.js"| DISCORD
