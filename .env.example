# Required environment for the scraper-bot service when deployed inside
# your personal-bots stack on the VPS. Copy to /home/ubuntu/bots/personal-bots/.env
# (next to your existing job-scraper entries) and adjust values.

# Claude Code image used for the bot container (same as your existing job-scraper).
CLAUDE_IMAGE=claude-code

# Path to the host's Claude config dir (carries the Discord bot token under
# channels/discord/.env). Same value your legacy job-scraper uses.
CLAUDE_CONFIG_DIR=/home/ubuntu/.claude
CLAUDE_CONFIG_FILE=/home/ubuntu/.claude.json

# Path to the workspace root containing scraper-bot/, scraper-mcp/, etc.
WORKSPACE_DIR=/home/ubuntu/bots/personal-bots

# Discord channel ID where scrape results are posted. Get it by enabling
# Discord developer mode and right-clicking the channel.
DISCORD_CHANNEL_ID=1330393101084266609

# Memory tuning + healthcheck values to mirror legacy.
SHM_SIZE=2gb
HC_INTERVAL=30s
HC_TIMEOUT=10s
HC_RETRIES=3
HC_START_PERIOD=60s

# MongoDB credentials (scraper-mcp + mongo services)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
